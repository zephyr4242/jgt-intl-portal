# 开发环境
VUE_APP_BUILD_MODE=NOMOCK

# 页面 title 前缀
VUE_APP_TITLE=国际业务门户

# 包名
VUE_APP_APPID=com.jgt.intlPortal
# 项目名
VUE_APP_PRODUCTNAME=国际业务门户

# 运行环境
VUE_APP_ENV=development
VUE_APP_DATA_SOURCE=api

# 对接 bus-jgt-intl
VUE_APP_API=http://localhost:8090
VUE_APP_LINK_PATH=http://localhost:8090

# 演示登录开关：true 走 localStorage demo-auth；默认关闭走真实认证

# 远端环境
VUE_APP_WEB_URL=http://localhost:8088/#/elogin

# 启用DEMO
VUE_APP_DEMO=N

# 登录注册：true=本地 demo-auth；默认走真实 /bus/jgt/intl/auth/*
