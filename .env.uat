# No Mock 构建

# 指定构建模式
NODE_ENV=production

# 页面 title 前缀
VUE_APP_TITLE=基煜国际业务门户 uat

# 标记当前是 No Mock 构建
VUE_APP_BUILD_MODE=NOMOCK

# 部署路径
# VUE_APP_PUBLIC_PATH=/openaccount/
# for 客户端
VUE_APP_PUBLIC_PATH=./

# 包名
VUE_APP_APPID=com.jgt.jgtClient
# 项目名
VUE_APP_PRODUCTNAME=基煜国际业务门户

# 运行环境
VUE_APP_ENV=uat
VUE_APP_DATA_SOURCE=api

# 远端环境
VUE_APP_WEB_URL=https://uat.jiyufund.com.cn/openaccount/#/elogin
