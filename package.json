{
  "name": "jgt-intl-portal",
  "version": "1.0.0",
  "engines": {
    "node": ">=16 <18",
    "npm": ">=8 <10"
  },
  "scripts": {
    "serve": "vue-cli-service serve --open",
    "serve:mock": "NODE_ENV=development vue-cli-service serve --mode mock --open",
    "serve:api": "NODE_ENV=development vue-cli-service serve --mode api --open",
    "build": "vue-cli-service build --mode nomock",
    "build:mock": "NODE_ENV=production vue-cli-service build --mode mock",
    "build:api": "NODE_ENV=production vue-cli-service build --mode api",
    "lint": "eslint --ext .js,.vue ./src",
    "lint:fix": "eslint --fix",
    "test:unit": "VUE_APP_DATA_SOURCE=mock vue-cli-service test:unit --runInBand",
    "dev": "npm run serve",
    "start": "npm run serve",
    "report": "vue-cli-service build --mode nomock --report"
  },
