# 所有环境默认

# 页面 title 前缀
VUE_APP_TITLE=国际业务门户

# 对接 bus-jgt-intl（本地默认 8090）
VUE_APP_API=http://localhost:8090
# 迭代号
VUE_APP_BIZ_ID=
# 代理目标（与 VUE_APP_API 保持一致）
VUE_APP_LINK_PATH=http://localhost:8090

# 仓库地址
VUE_APP_REPO=

# element 颜色
VUE_APP_ELEMENT_COLOR=#409EFF

# 文件服务器path
VUE_APP_FILE_PATH=

# 部署路径
VUE_APP_PUBLIC_PATH=/

# 开发环境不发监控
VUE_APP_SENTRY=http://localhost@null/1

# 启用DEMO
VUE_APP_DEMO=N

# 包名
VUE_APP_APPID=com.jgt.intlPortal
# 项目名
VUE_APP_PRODUCTNAME=国际业务门户
# 运行环境
VUE_APP_ENV=development

VUE_APP_WEB_URL=http://localhost:8088/#/elogin
